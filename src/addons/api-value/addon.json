{
  "id": "api-value",
  "name": "API / Stock Value",
  "version": "1.0.0",
  "description": "Fetches a JSON value (stock price, metric, or API field) server-side with caching and formatting.",
  "author": "Tilewright",
  "minHostVersion": "0.1.0",
  "contributes": {
    "server": {
      "assembly": "Tilewright.Addons.BuiltIn.dll",
      "entryType": "Tilewright.Addons.BuiltIn.ApiValueAddonModule"
    },
    "addonSettingsSchema": [
      { "key": "authHeaderName", "label": "Optional Auth Header Name", "type": "text", "helpText": "e.g. Authorization or X-API-Key" },
      { "key": "authHeaderValue", "label": "Optional Auth Header Value", "type": "secret", "helpText": "Write-only secret attached by the server." }
    ],
    "tiles": [
      {
        "id": "api-value",
        "name": "API / Stock Value",
        "description": "Server-side JSON API / stock ticker value with path extraction.",
        "icon": "chart-line",
        "element": { "tagName": "tw-addon-api-value", "script": "api-value-tile.js" },
        "defaultSize": { "w": 4, "h": 2 },
        "minSize": { "w": 2, "h": 1 },
        "maxSize": { "w": 12, "h": 6 },
        "settingsSchema": [
          { "key": "label", "label": "Label", "type": "text", "required": true, "defaultValue": "BP.L" },
          {
            "key": "layout",
            "label": "Layout",
            "type": "select",
            "defaultValue": "stacked",
            "options": [
              { "value": "stacked", "label": "Stacked (default)" },
              { "value": "inline", "label": "One line" }
            ]
          },
          { "key": "apiUrl", "label": "JSON API URL", "type": "url", "required": true, "helpText": "Fetched by the server (CORS-free)." },
          { "key": "jsonPath", "label": "JSON path", "type": "text", "helpText": "Dot/bracket path, e.g. chart.result[0].meta.regularMarketPrice" },
          { "key": "prefix", "label": "Prefix", "type": "text", "helpText": "e.g. £ or $" },
          { "key": "suffix", "label": "Suffix", "type": "text", "helpText": "e.g. p, %, USD" },
          { "key": "numberFormat", "label": "Number format (.NET)", "type": "text", "helpText": "Optional .NET format string, e.g. #,##0 or #,##0.00 or N0 (overrides Decimal places)." },
          { "key": "decimals", "label": "Decimal places", "type": "number", "min": 0, "max": 6, "defaultValue": 2 },
          { "key": "logoUrl", "label": "Logo URL (optional)", "type": "url" },
          { "key": "refreshInterval", "label": "Refresh interval", "type": "duration", "defaultValue": "2h" }
        ]
      },
      {
        "id": "api-multi-value",
        "name": "API / Stock List",
        "description": "Fetches a JSON API once and displays multiple extracted values as one-line rows.",
        "icon": "format-list-bulleted",
        "element": { "tagName": "tw-addon-api-multi-value", "script": "api-multi-value-tile.js" },
        "defaultSize": { "w": 6, "h": 2 },
        "minSize": { "w": 2, "h": 1 },
        "maxSize": { "w": 12, "h": 8 },
        "settingsSchema": [
          { "key": "title", "label": "Header title (optional)", "type": "text" },
          { "key": "apiUrl", "label": "JSON API URL", "type": "url", "required": true, "helpText": "Fetched once by the server (CORS-free)." },
          { "key": "refreshInterval", "label": "Refresh interval", "type": "duration", "defaultValue": "2h" },
          { "key": "showUpdated", "label": "Show updated time", "type": "toggle", "defaultValue": true },
          { "key": "positiveColour", "label": "Positive colour", "type": "colour", "defaultValue": "#22c55e" },
          { "key": "negativeColour", "label": "Negative colour", "type": "colour", "defaultValue": "#ef4444" },
          {
            "key": "items",
            "label": "Items",
            "type": "group",
            "fields": [
              { "key": "label", "label": "Label", "type": "text" },
              { "key": "priceJson", "label": "Price JSON", "type": "text" },
              { "key": "changeJson", "label": "Change JSON", "type": "text" },
              { "key": "prefix", "label": "Prefix", "type": "text" },
              { "key": "suffix", "label": "Suffix", "type": "text" },
              { "key": "numberFormat", "label": "Number format (.NET, overrides Decimals)", "type": "text" },
              { "key": "decimals", "label": "Decimals", "type": "number" },
              { "key": "logoUrl", "label": "Logo URL", "type": "url" }
            ]
          }
        ]
      },
      {
        "id": "api-portfolio",
        "name": "API Portfolio",
        "description": "Fetches a JSON API once and displays holding totals (price × qty) with an optional grand total.",
        "icon": "chart-line",
        "element": { "tagName": "tw-addon-api-portfolio", "script": "api-portfolio-tile.js" },
        "defaultSize": { "w": 6, "h": 2 },
        "minSize": { "w": 2, "h": 1 },
        "maxSize": { "w": 12, "h": 8 },
        "settingsSchema": [
          { "key": "title", "label": "Header title (optional)", "type": "text" },
          { "key": "apiUrl", "label": "JSON API URL", "type": "url", "required": true, "helpText": "Fetched once by the server (CORS-free)." },
          { "key": "refreshInterval", "label": "Refresh interval", "type": "duration", "defaultValue": "2h" },
          { "key": "showUpdated", "label": "Show updated time", "type": "toggle", "defaultValue": true },
          { "key": "showGrandTotal", "label": "Show grand total", "type": "toggle", "defaultValue": true },
          {
            "key": "grandTotalLabel",
            "label": "Grand total label",
            "type": "text",
            "defaultValue": "Total",
            "visibleWhen": { "key": "showGrandTotal", "equals": true }
          },
          {
            "key": "grandTotalFormat",
            "label": "Grand total format (optional)",
            "type": "text",
            "helpText": "Format string (e.g. £#,##0.00, $ #,###.00). Leave blank to use the first item's format.",
            "helpLinkUrl": "/format-guide.html",
            "helpLinkLabel": "Format guide",
            "visibleWhen": { "key": "showGrandTotal", "equals": true }
          },
          {
            "key": "grandTotalColour",
            "label": "Grand total colour",
            "type": "colour",
            "defaultValue": "#22c55e",
            "visibleWhen": { "key": "showGrandTotal", "equals": true }
          },
          {
            "key": "items",
            "label": "Items",
            "type": "group",
            "helpText": "Total format string supports number patterns like £#,##0.00, $ #,###.00, 0.00.",
            "helpLinkUrl": "/format-guide.html",
            "helpLinkLabel": "Format guide",
            "fields": [
              { "key": "iconUrl", "label": "Icon URL", "type": "url" },
              { "key": "name", "label": "Name", "type": "text" },
              { "key": "priceJson", "label": "Price JSON", "type": "text" },
              { "key": "qty", "label": "Qty", "type": "number" },
              { "key": "totalFormat", "label": "Total format string", "type": "text" }
            ]
          }
        ]
      }
    ]
  }
}
