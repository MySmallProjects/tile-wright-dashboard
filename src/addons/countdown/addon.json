{
  "id": "countdown",
  "name": "Countdown",
  "version": "1.0.0",
  "description": "Counts days until one-off, weekly, or yearly dates (Christmas, bin day, holidays).",
  "author": "Tilewright",
  "minHostVersion": "0.1.0",
  "contributes": {
    "tiles": [
      {
        "id": "countdown",
        "name": "Countdown",
        "description": "Days remaining until a target or repeating date.",
        "icon": "clock-outline",
        "element": { "tagName": "tw-addon-countdown", "script": "countdown-tile.js" },
        "defaultSize": { "w": 4, "h": 2 },
        "minSize": { "w": 2, "h": 2 },
        "maxSize": { "w": 12, "h": 6 },
        "settingsSchema": [
          { "key": "label", "label": "Label", "type": "text", "required": true, "defaultValue": "Bin Day" },
          {
            "key": "mode",
            "label": "Repeat mode",
            "type": "select",
            "defaultValue": "one-off",
            "options": [
              { "value": "one-off", "label": "One-off date" },
              { "value": "weekly", "label": "Weekly (day of week)" },
              { "value": "yearly", "label": "Yearly (e.g. Christmas)" }
            ]
          },
          {
            "key": "targetDate",
            "label": "Target date (YYYY-MM-DD)",
            "type": "text",
            "helpText": "Used for One-off or Yearly mode (e.g. 2026-12-25)."
          },
          {
            "key": "weekday",
            "label": "Day of week (Weekly mode)",
            "type": "select",
            "defaultValue": "4",
            "options": [
              { "value": "0", "label": "Sunday" },
              { "value": "1", "label": "Monday" },
              { "value": "2", "label": "Tuesday" },
              { "value": "3", "label": "Wednesday" },
              { "value": "4", "label": "Thursday" },
              { "value": "5", "label": "Friday" },
              { "value": "6", "label": "Saturday" }
            ]
          },
          { "key": "icon", "label": "Icon", "type": "icon", "defaultValue": "clock-outline" },
          {
            "key": "layout",
            "label": "Layout",
            "type": "select",
            "defaultValue": "stacked",
            "options": [
              { "value": "stacked", "label": "Stacked (default)" },
              { "value": "split", "label": "Split (Icon + Counter)" }
            ]
          }
        ]
      }
    ]
  }
}
