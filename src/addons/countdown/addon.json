{
  "id": "countdown",
  "name": "Countdown",
  "version": "1.0.0",
  "description": "Counts days until one-off, weekly, biweekly, or yearly dates (Christmas, bin day, holidays).",
  "author": "Tilewright",
  "minHostVersion": "0.1.0",
  "contributes": {
    "tiles": [
      {
        "id": "countdown",
        "name": "Countdown",
        "description": "Days remaining until a target or repeating date.",
        "icon": "clock-outline",
        "element": { "tagName": "tw-addon-countdown", "script": "countdown-tile.js" },
        "defaultSize": { "w": 4, "h": 2 },
        "minSize": { "w": 2, "h": 2 },
        "maxSize": { "w": 12, "h": 6 },
        "settingsSchema": [
          { "key": "label", "label": "Label", "type": "text", "required": true, "defaultValue": "Bin Day" },
          {
            "key": "mode",
            "label": "Repeat mode",
            "type": "select",
            "defaultValue": "one-off",
            "options": [
              { "value": "one-off", "label": "One-off date" },
              { "value": "weekly", "label": "Weekly (day of week)" },
              { "value": "biweekly", "label": "Every two weeks (from target date)" },
              { "value": "yearly", "label": "Yearly (e.g. Christmas)" }
            ]
          },
          {
            "key": "targetDate",
            "label": "Target date (YYYY-MM-DD)",
            "type": "text",
            "visibleWhen": { "key": "mode", "notEquals": "weekly" },
            "helpText": "Used for One-off, Every two weeks (anchor/start date), or Yearly mode (e.g. 2026-12-25)."
          },
          {
            "key": "weekday",
            "label": "Day of week (Weekly mode)",
            "type": "select",
            "defaultValue": "4",
            "visibleWhen": { "key": "mode", "equals": "weekly" },
            "options": [
              { "value": "0", "label": "Sunday" },
              { "value": "1", "label": "Monday" },
              { "value": "2", "label": "Tuesday" },
              { "value": "3", "label": "Wednesday" },
              { "value": "4", "label": "Thursday" },
              { "value": "5", "label": "Friday" },
              { "value": "6", "label": "Saturday" }
            ]
          },
          { "key": "icon", "label": "Icon", "type": "icon", "defaultValue": "clock-outline" },
          {
            "key": "iconSize",
            "label": "Icon size",
            "type": "select",
            "defaultValue": "medium",
            "options": [
              { "value": "small", "label": "Small (32x32)" },
              { "value": "medium", "label": "Medium (48x48)" },
              { "value": "large", "label": "Large (64x64)" },
              { "value": "xlarge", "label": "X-Large (128x128)" }
            ]
          },
          {
            "key": "counterSize",
            "label": "Counter text size",
            "type": "select",
            "defaultValue": "medium",
            "options": [
              { "value": "small", "label": "Small" },
              { "value": "medium", "label": "Medium (default)" },
              { "value": "large", "label": "Large" },
              { "value": "xlarge", "label": "X-Large" }
            ]
          },
          {
            "key": "layout",
            "label": "Layout",
            "type": "select",
            "defaultValue": "stacked",
            "options": [
              { "value": "stacked", "label": "Stacked (default)" },
              { "value": "split", "label": "Split (Icon + Counter)" }
            ]
          },
          {
            "key": "iconMarginLeft",
            "label": "Icon left margin (px)",
            "type": "number",
            "defaultValue": 0,
            "min": -128,
            "max": 128,
            "visibleWhen": { "key": "layout", "equals": "split" },
            "helpText": "Negative values (e.g. -20) shift the icon left to give more space to the counter."
          },
          {
            "key": "iconTrimX",
            "label": "Icon horizontal trim (px)",
            "type": "number",
            "defaultValue": 0,
            "min": 0,
            "max": 64,
            "visibleWhen": { "key": "layout", "equals": "split" },
            "helpText": "Trims transparent padding equally from both left and right sides of the icon (e.g. 20 trims 20px off each side)."
          }
        ]
      }
    ]
  }
}
