{
  "id": "homeassistant",
  "name": "Home Assistant",
  "version": "1.0.0",
  "description": "Live Home Assistant sensors (WebSocket) and device controls (REST) with semantic colour rules.",
  "author": "Tilewright",
  "minHostVersion": "0.1.0",
  "contributes": {
    "server": {
      "assembly": "Tilewright.Addons.BuiltIn.dll",
      "entryType": "Tilewright.Addons.BuiltIn.HomeAssistantAddonModule"
    },
    "addonSettingsSchema": [
      { "key": "baseUrl", "label": "Home Assistant Base URL", "type": "url", "required": false, "helpText": "e.g. http://homeassistant.local:8123 (leave blank to disconnect)" },
      { "key": "accessToken", "label": "Long-Lived Access Token", "type": "secret", "required": false, "helpText": "Created in your Home Assistant profile. Stored write-only on the server." }
    ],
    "tiles": [
      {
        "id": "sensor",
        "name": "HA Sensor (Read)",
        "description": "Displays live Home Assistant entity state (temp, power, humidity, air quality) with colour rules.",
        "icon": "lightning-bolt",
        "element": { "tagName": "tw-addon-ha-sensor", "script": "ha-sensor-tile.js" },
        "defaultSize": { "w": 4, "h": 2 },
        "minSize": { "w": 2, "h": 2 },
        "maxSize": { "w": 12, "h": 6 },
        "settingsSchema": [
          {
            "key": "entityId",
            "label": "Entity (from Home Assistant)",
            "type": "select",
            "dynamicOptionsEndpoint": "entities",
            "helpText": "Populated automatically once Home Assistant URL and token are configured in Settings → Addons."
          },
          {
            "key": "manualEntityId",
            "label": "Or enter Entity ID manually",
            "type": "text",
            "helpText": "e.g. sensor.living_room_temperature"
          },
          { "key": "label", "label": "Label override (optional)", "type": "text" },
          {
            "key": "labelPosition",
            "label": "Label position",
            "type": "select",
            "defaultValue": "top",
            "options": [
              { "value": "top", "label": "Top" },
              { "value": "bottom", "label": "Bottom" }
            ]
          },
          { "key": "unitOverride", "label": "Unit override (optional)", "type": "text" },
          {
            "key": "iconPosition",
            "label": "Icon position",
            "type": "select",
            "defaultValue": "none",
            "options": [
              { "value": "none", "label": "Hidden (default)" },
              { "value": "left", "label": "Left of value" },
              { "value": "right", "label": "Right of value" },
              { "value": "above", "label": "Above value" },
              { "value": "below", "label": "Below value" }
            ]
          },
          {
            "key": "icon",
            "label": "Icon (optional, defaults to HA entity icon)",
            "type": "icon"
          },
          {
            "key": "colourRules",
            "label": "Colour Rules",
            "type": "group",
            "helpText": "Evaluated in order (e.g. > 150 warning, > 300 critical).",
            "fields": [
              {
                "key": "operator",
                "label": "Op",
                "type": "select",
                "defaultValue": ">",
                "options": [
                  { "value": ">", "label": ">" },
                  { "value": ">=", "label": ">=" },
                  { "value": "<", "label": "<" },
                  { "value": "<=", "label": "<=" },
                  { "value": "==", "label": "==" },
                  { "value": "!=", "label": "!=" }
                ]
              },
              { "key": "threshold", "label": "Value", "type": "text" },
              {
                "key": "semanticState",
                "label": "State",
                "type": "select",
                "defaultValue": "warning",
                "options": [
                  { "value": "normal", "label": "Normal" },
                  { "value": "warning", "label": "Warning" },
                  { "value": "critical", "label": "Critical" }
                ]
              },
              { "key": "customColour", "label": "Custom colour", "type": "text", "helpText": "Optional CSS hex" }
            ]
          }
        ]
      },
      {
        "id": "control",
        "name": "HA Control (Toggle)",
        "description": "Toggle or trigger a Home Assistant switch, light, script, or scene with live state.",
        "icon": "home",
        "element": { "tagName": "tw-addon-ha-control", "script": "ha-control-tile.js" },
        "defaultSize": { "w": 4, "h": 2 },
        "minSize": { "w": 2, "h": 2 },
        "maxSize": { "w": 12, "h": 6 },
        "settingsSchema": [
          {
            "key": "entityId",
            "label": "Entity (from Home Assistant)",
            "type": "select",
            "dynamicOptionsEndpoint": "entities"
          },
          {
            "key": "manualEntityId",
            "label": "Or enter Entity ID manually",
            "type": "text",
            "helpText": "e.g. light.kitchen or switch.desk_lamp"
          },
          { "key": "label", "label": "Label override (optional)", "type": "text" },
          {
            "key": "labelPosition",
            "label": "Label position",
            "type": "select",
            "defaultValue": "top",
            "options": [
              { "value": "top", "label": "Top" },
              { "value": "bottom", "label": "Bottom" }
            ]
          },
          {
            "key": "service",
            "label": "Action service",
            "type": "select",
            "defaultValue": "toggle",
            "options": [
              { "value": "toggle", "label": "Toggle" },
              { "value": "turn_on", "label": "Turn On" },
              { "value": "turn_off", "label": "Turn Off" },
              { "value": "press", "label": "Press (Button)" }
            ]
          },
          {
            "key": "buttonLabel",
            "label": "Button label (optional)",
            "type": "text",
            "helpText": "Text shown on the button (e.g. for Press buttons instead of last-pressed timestamp)."
          },
          {
            "key": "displayMode",
            "label": "Button display",
            "type": "select",
            "defaultValue": "text",
            "options": [
              { "value": "text", "label": "Text / State pill (default)" },
              { "value": "icon", "label": "Icon" }
            ]
          },
          {
            "key": "iconOn",
            "label": "On icon (when Button display = Icon)",
            "type": "icon",
            "defaultValue": "lightning-bolt"
          },
          {
            "key": "iconOff",
            "label": "Off icon (when Button display = Icon)",
            "type": "icon",
            "defaultValue": "power"
          },
          {
            "key": "pressIcon",
            "label": "Press button icon (when Action = Press)",
            "type": "icon",
            "defaultValue": "home"
          },
          {
            "key": "showLastUpdated",
            "label": "Show last updated time",
            "type": "toggle",
            "defaultValue": false
          }
        ]
      }
    ]
  }
}
