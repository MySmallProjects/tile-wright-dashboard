{
  "id": "homeassistant",
  "name": "Home Assistant",
  "version": "1.0.0",
  "description": "Live Home Assistant sensors (WebSocket) and device controls (REST) with semantic colour rules.",
  "author": "Tilewright",
  "minHostVersion": "0.1.0",
  "contributes": {
    "server": {
      "assembly": "Tilewright.Addons.BuiltIn.dll",
      "entryType": "Tilewright.Addons.BuiltIn.HomeAssistantAddonModule"
    },
    "addonSettingsSchema": [
      { "key": "baseUrl", "label": "Home Assistant Base URL", "type": "url", "required": false, "helpText": "e.g. http://homeassistant.local:8123 (leave blank to disconnect)" },
      { "key": "accessToken", "label": "Long-Lived Access Token", "type": "secret", "required": false, "helpText": "Created in your Home Assistant profile. Stored write-only on the server." }
    ],
    "tiles": [
      {
        "id": "sensor",
        "name": "HA Sensor (Read)",
        "description": "Displays live Home Assistant entity state (temp, power, humidity, air quality) with colour rules.",
        "icon": "lightning-bolt",
        "element": { "tagName": "tw-addon-ha-sensor", "script": "ha-sensor-tile.js" },
        "defaultSize": { "w": 4, "h": 2 },
        "minSize": { "w": 2, "h": 2 },
        "maxSize": { "w": 12, "h": 6 },
        "settingsSchema": [
          {
            "key": "entityId",
            "label": "Entity (from Home Assistant)",
            "type": "select",
            "dynamicOptionsEndpoint": "entities",
            "helpText": "Populated automatically once Home Assistant URL and token are configured in Settings → Addons."
          },
          {
            "key": "manualEntityId",
            "label": "Or enter Entity ID manually",
            "type": "text",
            "helpText": "e.g. sensor.living_room_temperature"
          },
          { "key": "label", "label": "Label override (optional)", "type": "text" },
          {
            "key": "labelPosition",
            "label": "Label position",
            "type": "select",
            "defaultValue": "top",
            "options": [
              { "value": "top", "label": "Top" },
              { "value": "bottom", "label": "Bottom" }
            ]
          },
          { "key": "unitOverride", "label": "Unit override (optional)", "type": "text" },
          {
            "key": "valueFormat",
            "label": "Value format (optional)",
            "type": "text",
            "helpText": "Format numbers (e.g. #,##0.00, 0.000, $ #,###.00, 0.00 W) or dates/times (e.g. HH:mm, dd MMM HH:mm, relative). Leave blank for raw value.",
            "helpLinkUrl": "/format-guide.html",
            "helpLinkLabel": "Format guide"
          },
          {
            "key": "iconPosition",
            "label": "Icon position",
            "type": "select",
            "defaultValue": "none",
            "options": [
              { "value": "none", "label": "Hidden (default)" },
              { "value": "left", "label": "Left of value" },
              { "value": "right", "label": "Right of value" },
              { "value": "above", "label": "Above value" },
              { "value": "below", "label": "Below value" }
            ]
          },
          {
            "key": "icon",
            "label": "Icon (optional, defaults to HA entity icon)",
            "type": "icon"
          },
          {
            "key": "colourRules",
            "label": "Colour Rules",
            "type": "group",
            "helpText": "Evaluated top to bottom; the last matching rule wins (e.g. > 150 warning, > 300 critical).",
            "fields": [
              {
                "key": "operator",
                "label": "Op",
                "type": "select",
                "defaultValue": ">",
                "options": [
                  { "value": ">", "label": ">" },
                  { "value": ">=", "label": ">=" },
                  { "value": "<", "label": "<" },
                  { "value": "<=", "label": "<=" },
                  { "value": "==", "label": "==" },
                  { "value": "!=", "label": "!=" }
                ]
              },
              { "key": "threshold", "label": "Value", "type": "text" },
              {
                "key": "semanticState",
                "label": "State",
                "type": "select",
                "defaultValue": "warning",
                "options": [
                  { "value": "normal", "label": "Normal" },
                  { "value": "warning", "label": "Warning" },
                  { "value": "critical", "label": "Critical" }
                ]
              },
              { "key": "customColour", "label": "Custom colour", "type": "colour", "helpText": "Optional CSS hex" }
            ]
          }
        ]
      },
      {
        "id": "control",
        "name": "HA Control (Toggle)",
        "description": "Toggle or trigger a Home Assistant switch, light, script, or scene with live state.",
        "icon": "home",
        "element": { "tagName": "tw-addon-ha-control", "script": "ha-control-tile.js" },
        "defaultSize": { "w": 4, "h": 2 },
        "minSize": { "w": 2, "h": 2 },
        "maxSize": { "w": 12, "h": 6 },
        "settingsSchema": [
          {
            "key": "entityId",
            "label": "Entity (from Home Assistant)",
            "type": "select",
            "dynamicOptionsEndpoint": "entities"
          },
          {
            "key": "manualEntityId",
            "label": "Or enter Entity ID manually",
            "type": "text",
            "helpText": "e.g. light.kitchen or switch.desk_lamp"
          },
          {
            "key": "labelPosition",
            "label": "Label position",
            "type": "select",
            "defaultValue": "top",
            "options": [
              { "value": "top", "label": "Top" },
              { "value": "bottom", "label": "Bottom" },
              { "value": "none", "label": "Hidden" }
            ]
          },
          {
            "key": "label",
            "label": "Label override (optional)",
            "type": "text",
            "visibleWhen": { "key": "labelPosition", "notEquals": "none" }
          },
          {
            "key": "service",
            "label": "Action service",
            "type": "select",
            "defaultValue": "toggle",
            "options": [
              { "value": "toggle", "label": "Toggle" },
              { "value": "turn_on", "label": "Turn On" },
              { "value": "turn_off", "label": "Turn Off" },
              { "value": "press", "label": "Press (Button)" }
            ]
          },
          {
            "key": "buttonLabel",
            "label": "Button label (optional)",
            "type": "text",
            "helpText": "Text shown on the button (e.g. for Press buttons instead of last-pressed timestamp)."
          },
          {
            "key": "displayMode",
            "label": "Button display",
            "type": "select",
            "defaultValue": "text",
            "options": [
              { "value": "text", "label": "Text / State pill (default)" },
              { "value": "icon", "label": "Icon" }
            ]
          },
          {
            "key": "iconSize",
            "label": "Icon size",
            "type": "select",
            "defaultValue": "medium",
            "visibleWhen": { "key": "displayMode", "equals": "icon" },
            "options": [
              { "value": "small", "label": "Small (32x32)" },
              { "value": "medium", "label": "Medium (48x48)" },
              { "value": "large", "label": "Large (64x64)" },
              { "value": "xlarge", "label": "X-Large (128x128)" }
            ]
          },
          {
            "key": "iconOn",
            "label": "On icon (when Button display = Icon)",
            "type": "icon",
            "defaultValue": "lightning-bolt"
          },
          {
            "key": "iconOff",
            "label": "Off icon (when Button display = Icon)",
            "type": "icon",
            "defaultValue": "power"
          },
          {
            "key": "pressIcon",
            "label": "Press button icon (when Action = Press)",
            "type": "icon",
            "defaultValue": "home"
          },
          {
            "key": "showLastUpdated",
            "label": "Show last updated time",
            "type": "toggle",
            "defaultValue": false
          }
        ]
      },
      {
        "id": "control-split",
        "name": "HA Control (split)",
        "description": "Split-row Home Assistant control with a device icon, On/Off toggle status icon, and optional bottom label.",
        "icon": "home",
        "element": { "tagName": "tw-addon-ha-control-split", "script": "ha-control-split-tile.js" },
        "defaultSize": { "w": 4, "h": 2 },
        "minSize": { "w": 2, "h": 1 },
        "maxSize": { "w": 12, "h": 6 },
        "settingsSchema": [
          {
            "key": "entityId",
            "label": "Entity (from Home Assistant)",
            "type": "select",
            "dynamicOptionsEndpoint": "entities"
          },
          {
            "key": "manualEntityId",
            "label": "Or enter Entity ID manually",
            "type": "text",
            "helpText": "e.g. switch.washing_machine or light.kitchen"
          },
          {
            "key": "service",
            "label": "Action service",
            "type": "select",
            "defaultValue": "toggle",
            "options": [
              { "value": "toggle", "label": "Toggle" },
              { "value": "turn_on", "label": "Turn On" },
              { "value": "turn_off", "label": "Turn Off" },
              { "value": "press", "label": "Press (Button)" }
            ]
          },
          {
            "key": "deviceIcon",
            "label": "Device icon (optional, defaults to HA entity icon)",
            "type": "icon"
          },
          {
            "key": "deviceIconPosition",
            "label": "Device icon position",
            "type": "select",
            "defaultValue": "left",
            "options": [
              { "value": "left", "label": "Left (toggle on right)" },
              { "value": "right", "label": "Right (toggle on left)" }
            ]
          },
          {
            "key": "iconOn",
            "label": "On icon",
            "type": "icon",
            "defaultValue": "lightning-bolt"
          },
          {
            "key": "iconOff",
            "label": "Off icon",
            "type": "icon",
            "defaultValue": "power"
          },
          {
            "key": "pressIcon",
            "label": "Press button icon (when Action = Press)",
            "type": "icon",
            "defaultValue": "home"
          },
          {
            "key": "statusIconSize",
            "label": "Toggle status icon size",
            "type": "select",
            "defaultValue": "small",
            "options": [
              { "value": "small", "label": "Small (32x32)" },
              { "value": "medium", "label": "Medium (48x48)" },
              { "value": "large", "label": "Large (64x64)" }
            ]
          },
          {
            "key": "hideLabel",
            "label": "Hide label",
            "type": "toggle",
            "defaultValue": true
          },
          {
            "key": "label",
            "label": "Label override (optional)",
            "type": "text",
            "helpText": "Leave blank to use the Home Assistant entity's friendly name.",
            "visibleWhen": { "key": "hideLabel", "equals": false }
          },
          {
            "key": "showLastUpdated",
            "label": "Show last updated time",
            "type": "toggle",
            "defaultValue": false
          },
          {
            "key": "readOnly",
            "label": "ReadOnly",
            "type": "toggle",
            "defaultValue": false,
            "helpText": "Display status only; disables clicking to control the entity."
          }
        ]
      },
      {
        "id": "graph",
        "name": "HA Graph",
        "description": "Visualises a live Home Assistant numeric entity as a graph (e.g. half-circle gauge) with min/max range and colour rules.",
        "icon": "chart-line",
        "element": { "tagName": "tw-addon-ha-graph", "script": "ha-graph-tile.js" },
        "defaultSize": { "w": 4, "h": 3 },
        "minSize": { "w": 2, "h": 2 },
        "maxSize": { "w": 12, "h": 8 },
        "settingsSchema": [
          {
            "key": "entityId",
            "label": "Entity (from Home Assistant)",
            "type": "select",
            "dynamicOptionsEndpoint": "entities",
            "helpText": "Populated automatically once Home Assistant URL and token are configured in Settings → Addons."
          },
          {
            "key": "manualEntityId",
            "label": "Or enter Entity ID manually",
            "type": "text",
            "helpText": "e.g. sensor.living_room_humidity"
          },
          {
            "key": "title",
            "label": "Title (optional)",
            "type": "text",
            "helpText": "Leave blank to use the Home Assistant entity's friendly name."
          },
          {
            "key": "graphType",
            "label": "Graph type",
            "type": "select",
            "defaultValue": "gauge-simple",
            "options": [
              { "value": "gauge-simple", "label": "Gauge Simple" }
            ]
          },
          {
            "key": "minValue",
            "label": "Minimum value",
            "type": "number",
            "defaultValue": 0
          },
          {
            "key": "maxValue",
            "label": "Maximum value",
            "type": "number",
            "defaultValue": 100
          },
          { "key": "unitOverride", "label": "Unit override (optional)", "type": "text" },
          {
            "key": "valueFormat",
            "label": "Value format (optional)",
            "type": "text",
            "helpText": "Format numbers (e.g. #,##0.00, 0.000, $ #,###.00, 0.00 W). Leave blank for raw value.",
            "helpLinkUrl": "/format-guide.html",
            "helpLinkLabel": "Format guide"
          },
          {
            "key": "useCustomColour",
            "label": "Use custom gauge colour",
            "type": "toggle",
            "defaultValue": false
          },
          {
            "key": "fillColour",
            "label": "Gauge colour",
            "type": "colour",
            "defaultValue": "#22c55e",
            "visibleWhen": { "key": "useCustomColour", "equals": true }
          },
          {
            "key": "colourRules",
            "label": "Colour Rules",
            "type": "group",
            "helpText": "Evaluated top to bottom; the last matching rule wins (e.g. > 70 warning, > 90 critical).",
            "fields": [
              {
                "key": "operator",
                "label": "Op",
                "type": "select",
                "defaultValue": ">",
                "options": [
                  { "value": ">", "label": ">" },
                  { "value": ">=", "label": ">=" },
                  { "value": "<", "label": "<" },
                  { "value": "<=", "label": "<=" },
                  { "value": "==", "label": "==" },
                  { "value": "!=", "label": "!=" }
                ]
              },
              { "key": "threshold", "label": "Value", "type": "text" },
              {
                "key": "semanticState",
                "label": "State",
                "type": "select",
                "defaultValue": "warning",
                "options": [
                  { "value": "normal", "label": "Normal" },
                  { "value": "warning", "label": "Warning" },
                  { "value": "critical", "label": "Critical" }
                ]
              },
              { "key": "customColour", "label": "Custom colour", "type": "colour", "helpText": "Optional CSS hex" }
            ]
          }
        ]
      }
    ]
  }
}
